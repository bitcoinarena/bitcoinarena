+if (process.env.ARENA_BUNDLE_OFFERS === '1') out += '         offerIndex: offerIndex, OFFER_SLOTS: OFFER_SLOTS,\n';
 out += '         create: create, WORDS: WORDS };\n})();\n';
 out += 'if (typeof module !== "undefined") module.exports = ' + GLOBAL + ';\n';
 
