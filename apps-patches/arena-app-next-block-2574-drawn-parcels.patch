+// SPDX-License-Identifier: LicenseRef-Bitcoin-Arena-1.0
+// Copyright (c) 2026 The Bitcoin Arena authors. See LICENSE.
+// SIGNS NEXTBLOCK'S MANIFEST VERSION 8: version 7 in every term but its core and that core's browser bundle - 383aa469,
+// 8cbc74b2 with its parcels drawn from the round's beacon block (the Arena's kanban #2571 ruling; truck-cores.js NEXTBLOCK_CORES_V8,
+// clients.json pinnedV8) - beside the game's mark. Its parent is version 7. Writes plugin/nextblock-v8.js and plugin/known-v8.js, both generated, public bytes only.
+//   node tools/sign-manifest-v8.mjs <dev dir holding game-dev.pkcs8>
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { MANIFEST_V7, GAME_ID_V7 } from '../plugin/nextblock-v7.js';
+import { NEXTBLOCK_CORES_V8 } from '../plugin/truck-cores.js';
+import { gameDevKey, signManifest } from 'arena-sdk/manifest-sign';
+import { encodeManifest, gameIdOf, manifestStands } from 'arena-sdk/manifest';
+import { toHex, fromHex } from 'arena-sdk/hash';
+import { verifyEd25519 } from 'arena-sdk/ed25519';
+
+const sorted = (hs) => [...hs].sort();
+
+/** Version 7's terms, unsigned: what the developer's key signs, and all a test can hold it to before it is signed. */
+export function manifestV8Body() {
+  const CLIENTS = JSON.parse(readFileSync(new URL('../plugin/clients.json', import.meta.url), 'utf8'));
+  const { signature, ...v6body } = MANIFEST_V7;
+  void signature;
+  return {
+    ...v6body,
+    version: MANIFEST_V7.version + 1,
+    parentManifestId: GAME_ID_V7,
+    cores: sorted([...NEXTBLOCK_CORES_V8.keys()]).map((h) => ({ hash: fromHex(h), configs: sorted([...NEXTBLOCK_CORES_V8.get(h).configs.keys()]).map(fromHex) })),
+    clients: sorted([...Object.values(CLIENTS.pinnedV8).flat(), ...Object.values(CLIENTS.markV6).flat()]).map(fromHex),
+  };
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const [dir] = process.argv.slice(2);
+  if (!dir) { console.error('usage: node sign-manifest-v8.mjs <dev dir holding game-dev.pkcs8>'); process.exit(2); }
+  const dev = gameDevKey(readFileSync(join(dir, 'game-dev.pkcs8')));
+  if (toHex(dev.pubkey) !== toHex(MANIFEST_V7.gameDevPubkey)) throw new Error(`that key is not nextblock's developer key ${toHex(MANIFEST_V7.gameDevPubkey).slice(0, 16)}`);
+  const body = manifestV8Body();
+  const manifest = signManifest(body, dev);
+  const stands = manifestStands(manifest, { verify: verifyEd25519, parentOf: (id) => (toHex(id) === toHex(GAME_ID_V7) ? MANIFEST_V7 : null) });
+  if (!stands.ok) throw new Error(stands.why);
+  const id = toHex(gameIdOf(manifest));
+  writeFileSync(new URL('../plugin/nextblock-v8.js', import.meta.url), `// GENERATED by tools/sign-manifest-v8.mjs with the dev client's signer - do not edit by hand. PUBLIC BYTES ONLY:
+// nextblock's GameManifest version 8: version 7 (${toHex(GAME_ID_V7)}) in every term but its core and that core's bundle - 383aa469,
+// the parcels drawn from the round's beacon block. Signed by its developer key ${toHex(dev.pubkey)}; a node verifies it.
+// game_id ${id}
+import { GAME as V1 } from './nextblock.js';
+import { NEXTBLOCK_CORES_V8 } from './truck-cores.js';
+import { decodeManifest, gameIdOf } from 'arena-sdk/manifest';
+import { fromHex } from 'arena-sdk/hash';
+
+export const MANIFEST_V8_HEX = '${toHex(encodeManifest(manifest))}';
+export const MANIFEST_V8 = decodeManifest(fromHex(MANIFEST_V8_HEX));
+export const GAME_ID_V8 = gameIdOf(MANIFEST_V8);
+/** What a launcher loads from this module (ARENA_APPS): the registration. */
+export const GAME = Object.freeze({ ...V1, manifest: MANIFEST_V8, gameId: GAME_ID_V8, cores: NEXTBLOCK_CORES_V8 });
+`);
+  writeFileSync(new URL('../plugin/known-v8.js', import.meta.url), `// GENERATED by tools/sign-manifest-v8.mjs. WHAT A CLIENT LISTS OF NEXTBLOCK VERSION 8: its signed bytes and the configs it plays as one world
+// per round, as known-v4.js lists version 4.
+//
+//   node packages/arena-protocol/tools/known-games.js packages/nextblock/plugin/known-v8.js
+import { MANIFEST_V8_HEX } from './nextblock-v8.js';
+import { NEXTBLOCK_CORES_V8 } from './truck-cores.js';
+
+export const KNOWN_GAME = Object.freeze({
+  manifestHex: MANIFEST_V8_HEX,
+  sharedWorld: [...new Set([...NEXTBLOCK_CORES_V8.values()].flatMap((c) => [...c.configs].filter(([, cfg]) => cfg && cfg.worldShared).map(([h]) => h)))],
+});
+`);
+  console.log(`nextblock v${body.version}: parent ${toHex(GAME_ID_V7).slice(0, 16)}, ${body.cores.length} cores, ${body.clients.length} clients, game_id ${id}`);
+}
