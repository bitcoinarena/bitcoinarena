[Unit]
Description=BLWP dev donation client "dev <x>" (the owner 2026-10-03): asks the seats what its key was given, redeems in every federation, withdraws to LND C
[Service]
ExecStart=/home/arena/.nvm/versions/node/v24.15.0/bin/node /home/arena/blwp-testnet4/code/packages/blwp-donor/bin/blwp-donor.mjs loop /home/arena/blwp-testnet4/donor-<x>
Restart=always
RestartSec=30
StandardOutput=append:/home/arena/blwp-testnet4/donor-<x>/donor.log
StandardError=append:/home/arena/blwp-testnet4/donor-<x>/donor.log
[Install]
WantedBy=default.target
